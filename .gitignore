# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.swp
*.swo
*~
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
!/sample-data/*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/.vite/
/.cache/
/.turbo/
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# python
__pycache__/
*.py[cod]
*$py.class
/.venv/
/venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# local databases and runtime state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# CAN captures and local exports
*.candump
*.pcap
*.pcapng
*.jsonl
/captures/

# locally packaged releases
*.zip
*.tar.gz
*.tgz
